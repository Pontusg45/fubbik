                    {
                        "source": "concepts/routes.ts",
                        "reason": "No active product consumer uses the legacy concepts API."
                    },
                    {
                        "source": "diagram/routes.ts",
                        "reason": "No active product consumer uses the server-side diagram API."
                    },
                    {
                        "source": "usage/routes.ts",
                        "reason": "The legacy route returns placeholder data and has no active consumer."
                    }
                ]
            },
            "rustTargets": [
                "crates/fubbik-api/src/lib.rs",
                "crates/fubbik-api/src/chunks/routes.rs",
                "crates/fubbik-api/src/chunks/groups.rs",
