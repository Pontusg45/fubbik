{
    "version": 1,
    "objective": "Run the Fubbik backend, CLI, MCP server, database maintenance, and production web serving without a Node or Bun runtime.",
    "allowedAfterCutover": [
        "TypeScript frontend source and its build-time toolchain",
        "VS Code extension source and its build-time toolchain",
        "contract fixtures retained for compatibility tests"
    ],
