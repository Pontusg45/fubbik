                    "requirements.ts",
                    "tag-group.ts",
                    "tags.ts"
                ],
                "partial": [],
                "pending": [],
                "retire": [
                    {
                        "source": "diff.ts",
                        "reason": "The Rust cutover removes the local JSON chunk store, so comparing local-store records against the authoritative server has no server-only meaning."
                    },
                    {
                        "source": "sync.ts",
                        "reason": "The Rust cutover removes the local JSON chunk store, so local-to-server replication is obsolete; server-backed commands write directly to the API."
                    }
                ]
            },
            "rustTargets": [
                "crates/fubbik-cli/src/lib.rs",
                "crates/fubbik-cli/src/commands"
            ],
            "exitCriterion": "Every supported legacy invocation has a Rust implementation or a documented compatibility alias, including exit codes and JSON output."
        },
        "mcpSources": {
            "inventory": {
                "root": "packages/mcp/src",
                "suffix": ".ts",
                "excludeSuffix": ".test.ts"
            },
            "statuses": {
