                "crates/fubbik-api/src/file_refs/routes.rs",
                "crates/fubbik-api/src/health/routes.rs"
            ],
            "exitCriterion": "Every retained HTTP contract is implemented and contract-tested in fubbik-api; retired routes have no callers."
        },
