  "components": {
    "schemas": {
      "AppliesTo": {
        "type": "object",
        "required": [
          "id",
          "chunkId",
          "pattern"
        ],
        "properties": {
          "chunkId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          }
        }
      },
      "Chunk": {
        "type": "object",
        "description": "`camelCase` serialisation is mandatory, not cosmetic: the 106 web files\nthat consume this API were written against Drizzle's camelCase output.\nEmitting snake_case would silently break every one of them.",
        "required": [
          "id",
          "title",
          "content",
          "type",
          "userId",
          "aliases",
          "notAbout",
          "scope",
          "origin",
          "reviewStatus",
          "createdAt",
          "updatedAt",
          "isEntryPoint"
        ],
        "properties": {
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternatives": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "consequences": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "documentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentOrder": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "embedding": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "format": "float"
            }
          },
          "embeddingUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "isEntryPoint": {
            "type": "boolean"
          },
          "notAbout": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewStatus": {
            "type": "string"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "ChunkListResponse": {
        "type": "object",
        "description": "Response envelope for `GET /api/chunks`, matching the Node/Elysia\nbackend's `{ chunks, total, limit, offset }` shape (the web app reads\n`.chunks` and `.total` directly). `total` is the count of rows matching\nthe same filters as `chunks` but WITHOUT `limit`/`offset` applied — see\n`fubbik_db::repo::chunk::count`, which shares its filter-building logic\nwith `list` so the two can never disagree.",
        "required": [
          "chunks",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ChunkVersion": {
        "type": "object",
        "required": [
          "id",
          "chunkId",
          "version",
          "title",
          "content",
          "type",
          "createdAt"
        ],
        "properties": {
          "chunkId": {
            "type": "string"
          },
          "consequences": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CreateChunkBody": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateTagTypeBody": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "FileRef": {
        "type": "object",
        "required": [
          "id",
          "chunkId",
          "path"
        ],
        "properties": {
          "chunkId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "description": "Shape of every `{ message: \"Deleted\" }` delete response in this domain,\nmatching Node's convention (`_mutating.md`): deletes return 200, not\n204, with this body.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "PathsBody": {
        "type": "object",
        "required": [
          "paths"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PatternsBody": {
        "type": "object",
        "required": [
          "patterns"
        ],
        "properties": {
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Sort": {
        "type": "string",
        "enum": [
          "newest",
          "oldest",
          "alpha",
          "updated"
        ]
      },
      "TagType": {
        "type": "object",
        "description": "`camelCase` serialisation matches every other wire type in this crate —\nsee the note on `chunk::Chunk` for why that's mandatory, not cosmetic.",
        "required": [
          "id",
          "name",
          "color",
          "userId",
          "createdAt"
        ],
        "properties": {
          "color": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "UpdateChunkBody": {
        "type": "object",
        "properties": {
          "consequences": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UpdateTagTypeBody": {
        "type": "object",
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
