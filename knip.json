{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignore": [".agents/**", ".claude/**", ".kiro/**"],
    "ignoreDependencies": ["dotenv"],
    "workspaces": {
        ".": {
            "ignoreDependencies": ["@fubbik/config", "@fubbik/env"]
        },
        "apps/web": {
            "entry": ["src/routes/**/*.{ts,tsx}", "src/router.tsx"],
            "project": ["src/**/*.{ts,tsx}"],
            "ignoreDependencies": ["@tanstack/router-plugin", "@fontsource-variable/inter", "@tanstack/react-router-with-query"],
            "ignore": ["src/components/ui/**"]
        },
        "packages/db": {
            "project": ["src/**/*.ts"]
        },
        "packages/env": {
            "project": ["src/**/*.ts"]
        },
        "packages/config": {
            "ignore": ["**/*"]
        }
    }
}
