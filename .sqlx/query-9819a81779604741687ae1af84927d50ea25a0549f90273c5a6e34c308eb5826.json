{
  "db_name": "PostgreSQL",
  "query": "INSERT INTO user_favorite (id, user_id, chunk_id, \"order\")\n           SELECT $1, $2, c.id, $4\n           FROM chunk c\n           WHERE c.id = $3 AND c.user_id = $2\n           ON CONFLICT DO NOTHING\n           RETURNING id, user_id, chunk_id, \"order\",\n                     created_at AS \"created_at: UtcTimestamp\"",
