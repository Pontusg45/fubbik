  "query": "INSERT INTO plan_external_link (id, plan_id, system, url, label)\n           SELECT $1, p.id, $3, $4, $5\n           FROM plan p\n           WHERE p.id = $2 AND p.user_id = $6\n           RETURNING id, plan_id, system, url, label, \"order\",\n                     created_at AS \"created_at: UtcTimestamp\"",
