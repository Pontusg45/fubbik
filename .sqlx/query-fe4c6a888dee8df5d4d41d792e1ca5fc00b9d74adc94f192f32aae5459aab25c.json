  "query": "SELECT id, user_id, type AS notification_type, title, message, link_to, read,\n                  created_at AS \"created_at: UtcTimestamp\"\n           FROM notification\n           WHERE user_id = $1 AND ($2::bool = false OR read = false)\n           ORDER BY created_at DESC, id ASC\n           LIMIT $3",
