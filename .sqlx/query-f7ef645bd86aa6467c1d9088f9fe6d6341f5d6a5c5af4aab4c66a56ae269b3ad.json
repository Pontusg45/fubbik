  "query": "SELECT c.id AS chunk_id, c.title AS chunk_title, c.type AS chunk_type,\n                  f.id AS ref_id, f.path, f.anchor, f.relation\n           FROM chunk_file_ref f\n           JOIN chunk c ON c.id = f.chunk_id\n           WHERE c.user_id = $1\n           ORDER BY f.path, f.id",
