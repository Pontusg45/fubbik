# Local dev: leave API origin unset — the Vite dev server proxies `/api` to the Rust API.
# Production / Docker: set the public API URL (see docker-compose.selfhost.yml).
# VITE_API_ORIGIN=https://api.example.com

# Temporary Node backend for unported routes during local development.
# VITE_LEGACY_API_ORIGIN=http://localhost:3002

# Deprecated aliases (still read as fallbacks):
# VITE_SERVER_URL=http://localhost:3000
# VITE_API_URL=http://localhost:3000
